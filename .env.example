APP_NAME=Looper-AI-Gateway
HOST=0.0.0.0
PORT=8080

# Required: set a random token of at least 32 characters before starting.
ADMIN_TOKEN=
DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db
CREDENTIAL_KEY_FILE=./data/credential.key
# Optional Fernet key; if empty, a persistent key file is generated automatically.
CREDENTIAL_ENCRYPTION_KEY=

UPSTREAM_BASE_URL=https://chatgpt.com/backend-api
UPSTREAM_AUTH_MODE=oauth_manual
UPSTREAM_BEARER_TOKEN=
UPSTREAM_TIMEOUT_SECONDS=120
# Keep the API local by default. Set 0.0.0.0 only when remote clients are needed.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_HOST_PORT=34567
# Optional HTTP(S) proxy for model requests and OAuth exchange/refresh.
UPSTREAM_PROXY_URL=
UPSTREAM_MAX_ATTEMPTS=3
UPSTREAM_FAILURE_COOLDOWN_SECONDS=10
UPSTREAM_RATE_LIMIT_COOLDOWN_SECONDS=60
UPSTREAM_CAPACITY_WAIT_SECONDS=15
MAX_REQUEST_BYTES=16777216
# Image inputs may contain base64 data URLs and need a larger JSON envelope.
MAX_IMAGE_REQUEST_BYTES=67108864
UPSTREAM_TRANSPORT=sse
UPSTREAM_OPENAI_BETA=responses=experimental
DEFAULT_INSTRUCTIONS=You are a helpful assistant.
# Display only for GET /v1/models; unlisted models are allowed too.
# Manage the persistent blacklist with manage.py block-model / unblock-model.
MODEL_CATALOG=gpt-6.1-sol

OAUTH_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
OAUTH_SCOPE=openid profile email offline_access
OAUTH_AUDIENCE=
OAUTH_ORIGINATOR=pi
OAUTH_CODEX_CLI_SIMPLIFIED_FLOW=true
OAUTH_ID_TOKEN_ADD_ORGANIZATIONS=true
OAUTH_SESSION_TTL_MINUTES=15

CODEX_COMMAND=codex
CODEX_LOGIN_COMMAND=
CODEX_HOME=~/.codex
CODEX_AUTH_CREDENTIALS_STORE=file
CODEX_LOGIN_LOG_FILE=./data/codex-login.log
